{
  "name": "mediaforge-ai",
  "version": "1.0.0",
  "description": "Professional Windows Desktop Media Downloader & AI Video Translation Studio",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "build:electron": "tsc -p tsconfig.electron.json",
    "watch:electron": "tsc -p tsconfig.electron.json --watch --preserveWatchOutput",
    "dev": "npm run build:electron && concurrently -k -p \"[{name}]\" -n \"VITE,TSC,APP\" -c \"cyan.bold,yellow.bold,green.bold\" \"vite\" \"npm run watch:electron\" \"node wait-and-start.js\"",
    "build": "tsc --noEmit && vite build && npm run build:electron",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "start": "npm run build:electron && electron ."
  },
  "keywords": [
    "media",
    "downloader",
    "ai",
    "translation",
    "whisper",
    "subtitles",
    "dubbing",
    "video-editing"
  ],
  "author": "MediaForge AI Team",
  "license": "MIT",
  "dependencies": {
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^35.0.0",
    "typescript": "^5.8.2",
    "vite": "^6.2.0"
  }
}
